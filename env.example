# Server Configuration
SERVER_PORT=3005
BODY_LIMIT=10mb

# Database Configuration
CONNECTION_STRING=mongodb://localhost:27017/huawei-health-ai-backend
DATABASE_NAME=huawei-health-ai-backend
DATABASE_POOL_SIZE=10
MONGO_TRANSACTIONS_ENABLED=false

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:3000

# Compression Configuration
COMPRESSION_LEVEL=6

# JWT/Crypto Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=30d
JWT_ROUNDS=10

# Analytics Configuration
ANALYTICS_API_KEY=your-analytics-api-key
ANALYTICS_ENABLED=true

# Cache Configuration
USE_DISTRIBUTED_CACHE=false
REDIS_INTERNAL_URL=redis://localhost:6379

# Swagger Configuration
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
