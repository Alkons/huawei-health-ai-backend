# Server Configuration
SERVER_PORT=3005
BODY_LIMIT=10mb

# Database Configuration
CONNECTION_STRING=mongodb://admin:password@localhost:27017/huawei-health-ai-backend?authSource=admin
DATABASE_NAME=huawei-health-ai-backend
DATABASE_POOL_SIZE=10
MONGO_TRANSACTIONS_ENABLED=false

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:3000

# Compression Configuration
COMPRESSION_LEVEL=6

# JWT/Crypto Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=30d
JWT_ROUNDS=10

# Analytics Configuration
ANALYTICS_API_KEY=your-analytics-api-key
ANALYTICS_ENABLED=true

# Cache Configuration
USE_DISTRIBUTED_CACHE=false
REDIS_INTERNAL_URL=redis://localhost:6379

# Swagger Configuration
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# Huawei OAuth Configuration
HUAWEI_OAUTH_AUTHORIZE_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/authorize
HUAWEI_OAUTH_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_CLIENT_ID=your-huawei-client-id
HUAWEI_CLIENT_SECRET=your-huawei-client-secret
HUAWEI_REDIRECT_URI=http://localhost:3005/v1/integrations/huawei/callback
HUAWEI_ALLOWED_CLIENT_REDIRECT_ORIGINS=http://localhost:3000
HUAWEI_TOKEN_ENCRYPTION_KEY=base64-32-bytes-key

# Legal / UX Links (served by frontend)
PRIVACY_POLICY_URL=http://localhost:3000/privacy
NON_MEDICAL_DISCLAIMER_URL=http://localhost:3000/disclaimer
MANAGE_CONSENT_URL=http://localhost:3000/settings/consent

# AI Provider Configuration (OpenAI Compatible)
AI_PROVIDER_API_KEY=your-api-key-here
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

